{
  "schema_version": "wearable-assistant-v1",
  "endpoint": {
    "base_url": "http://127.0.0.1:8000/v1",
    "model": "Qwen/Qwen3.5-2B",
    "api_key_env": "MODEL_API_KEY",
    "temperature": 0,
    "max_tokens": 512,
    "timeout": 45,
    "chat_template_kwargs": {"enable_thinking": false}
  },
  "runtime": {
    "seed": 42,
    "max_model_calls": 20,
    "max_tool_calls": 12,
    "max_seconds": 240,
    "max_input_chars": 100000,
    "max_total_tokens": 32768,
    "max_protocol_repairs": 1,
    "direct_weather_completion": true,
    "reuse_successful_reads": true,
    "max_repeated_read_attempts": 3,
    "max_consecutive_tool_failures": 3,
    "grounded_assistance": true,
    "local_fast_path": true,
    "context_window": 8192,
    "context_tokenizer": "models/Qwen3.5-2B"
  },
  "dataset": "data/wearable_tasks/formal",
  "world_file": "examples/assistant-world.json",
  "tool_backend": {"kind": "local"}
}
